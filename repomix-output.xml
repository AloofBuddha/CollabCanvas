    '#EC4899': 'Bright Pink',
    '#BE185D': 'Deep Pink',
    '#F43F5E': 'Bright Rose',
    '#BE123C': 'Deep Rose',
  }
  
  return colorNames[hexColor] || 'Unknown'
}
